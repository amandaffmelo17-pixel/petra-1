# PETRA runtime
PETRA_ENVIRONMENT=production
PETRA_VERSION=0.1.0
PORT=3000

# PostgreSQL — required for live data
PETRA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PETRA_DB_POOL_MAX=10

# MOTOR PETRA — optional integration
MOTOR_PETRA_URL=
MOTOR_PETRA_SERVICE_TOKEN=

# Automation worker — enable when the runtime has a persistent process
PETRA_AUTOMATION_WORKER_ENABLED=true
PETRA_AUTOMATION_POLL_MS=2000
PETRA_AUTOMATION_BATCH=10
